{
  "name": "llm-speedtest",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:ollama": "vitest run --config vitest.live.config.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "deploy:check": "npm run build && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "deploy": "npm run build && wrangler deploy && wrangler d1 migrations apply DB --remote",
    "dev:worker": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.0.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.0.0"
  }
}
